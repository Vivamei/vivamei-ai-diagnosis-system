# =========================================================
# AI 美学顾问 Prompt 实现版配置
# =========================================================

# 可选值：
# mock       ：本地模拟，不调用真实大模型，适合先跑通流程
# qwen       ：调用阿里云百炼 Qwen-VL / Qwen 视觉模型
# volcengine ：调用火山方舟 / 豆包视觉模型
LLM_PROVIDER=qwen

# =========================================================
# 阿里云百炼 / Qwen OpenAI 兼容接口
# =========================================================
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-plus

# =========================================================
# 火山方舟 / 豆包 OpenAI 兼容接口
# =========================================================
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=

# =========================================================
# 本地上传图片后真实调用视觉大模型时需要公网 URL
# 例如使用 ngrok 后填写：https://xxxx.ngrok-free.app
# mock 模式不需要填写
# =========================================================
PUBLIC_BASE_URL=https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTuMknBE3rbJ82cGFUZBMsC2YT3xfC2qhXMYNUv3y7uww&s=10

# =========================================================
# 服务配置
# =========================================================
HOST=0.0.0.0
PORT=8000

# =========================================================
# 200 人高频访问：Redis + Celery 排队与限流
# Docker Compose 内使用默认地址；外部 Redis 请改为对应内网地址。
# QUEUE_GLOBAL_MAX_INFLIGHT 必须不超过大模型账户可承受的任务并发。
# =========================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
QUEUE_USER_REQUESTS_PER_MINUTE=5
QUEUE_USER_MAX_ACTIVE_JOBS=5
QUEUE_IP_REQUESTS_PER_MINUTE=300
QUEUE_IP_MAX_ACTIVE_JOBS=300
QUEUE_GLOBAL_MAX_QUEUED_JOBS=500
QUEUE_GLOBAL_MAX_INFLIGHT=10
QUEUE_JOB_TTL_SECONDS=86400
QUEUE_EXECUTION_LEASE_SECONDS=600

# 仅当请求必经可信反向代理时开启；否则 X-Forwarded-For 可被伪造。
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
