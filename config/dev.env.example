# 本地开发配置样例：cp config/dev.env.example config/dev.env 即可跑，无需任何云端账号。
#
# 默认是「全 mock」档：不发真短信、不调微信、不调大模型、不传 OSS、不做机审，
# 缺哪项配置就自动降级哪项（APP_ENV=dev 下不校验）。想让某项走真实服务，
# 把对应的凭据填上即可，代码不用动。各项当前是真是假，随时可查：
#   cd apps/api && poetry run python -m app.core.preflight
#
# 本文件列出了 apps/api/app/core/config.py 里 Settings 的**全部**字段。
# 注释掉的行 = 用代码默认值即可，值就写在注释里，要改直接去掉行首 # 号。
# 键名大小写不敏感，未识别的键会被静默忽略（extra="ignore"），拼错不会报错，注意别写错。

# === App ===
# dev | test | prod。dev 放松各项自检；test 由 conftest 自动设置，不要手工填。
APP_ENV=dev
# 开 FastAPI 调试模式（详细报错页）。线上必须 false。
APP_DEBUG=true
# 后端自身的对外基址，用于拼回调/绝对链接。
APP_BASE_URL=http://localhost:8080
# 前端站点基址，短信落地页等拼绝对地址用它。
WEB_BASE_URL=http://localhost:5173
# 跨域来源白名单（逗号分隔的完整 origin）。留空 = 不挂 CORS 中间件。
# 前端 devServer 已代理 /api，同源无跨域，保持留空即可。
CORS_ORIGINS=
# mock 放行名单：列进来的按 mock 跑，没列的必须走真实服务（缺凭据则拒绝启动）。
# 可选值：sms / wechat / llm / moderation / oss
# 这里预填全 mock，clone 下来不配任何凭据就能起；接通哪个就把哪个从名单里去掉。
ALLOW_MOCK=sms,wechat,llm,moderation,oss

# === Database / Cache ===
# 必填。异步驱动 aiomysql，库名 venus，账号 venus/devpass 与 docker-compose.dev.yml 一致。
DATABASE_URL=mysql+aiomysql://venus:devpass@localhost:3306/venus
# 必填。限流计数、SSE buffer、验证码都存这里。
REDIS_URL=redis://localhost:6379/0
# 本地无 Redis 时可改为 memory:// 走 fakeredis（仅 dev，进程退出即清空）
# REDIS_URL=memory://
# Redis 连接池上限。本地单进程用不满，默认即可。
# REDIS_MAX_CONNECTIONS=200
# DB 连接池（每 worker 一份）。总连接 ≈ (POOL_SIZE + MAX_OVERFLOW) × UVICORN_WORKERS。
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# 池满后等待连接的超时（秒），超时抛 TimeoutError。
# DB_POOL_TIMEOUT=30
# uvicorn worker 进程数。本地 --reload 只跑单进程，改它无效。
# UVICORN_WORKERS=1

# === JWT ===
# 必填。签发/校验令牌的密钥，线上用 openssl rand -hex 32 生成。
JWT_SECRET=change-me-in-prod-please-use-openssl-rand-hex-32
# access token 有效期（秒），默认 1 小时。
JWT_ACCESS_TTL_SECONDS=3600
# refresh token 有效期（秒），默认 7 天。
JWT_REFRESH_TTL_SECONDS=604800

# === 管理员令牌 ===
# 保护 /api/admin/*（返回解密手机号等 PII）。留空 = 接口一律拒绝（fail-closed）。
# 本地要调导数接口就填个随便的串，请求头带 X-Admin-Token。
ADMIN_TOKEN=

# === Phone Crypto (AES-GCM via KMS-managed KEK) ===
# 必填。手机号密文的数据密钥，base64 编码的 32 字节；dev 随便填，prod 用 KMS 动态获取。
PHONE_DEK_BASE64=change-me-base64-32-bytes
# 必填。手机号盲索引（查重/查询用）的 HMAC 密钥。换了它历史数据就查不出来。
PHONE_HMAC_KEY=change-me-hmac-key-256bit

# === 阿里云 ===
# 留空 = 短信走测试模式（见下）。填真实 AK 只影响短信；OSS 与内容审核另有总开关。
ALI_ACCESS_KEY_ID=
ALI_ACCESS_KEY_SECRET=
# 短信等通用服务的地域。
ALI_REGION=cn-hangzhou

# OSS
# 总开关。false = 原图落本机 apps/api/var/uploads/，本地开发够用，不需要任何云资源。
# 想在本地连真 OSS：置 true 并把下面 bucket/endpoint/AK 填成真实值。
OSS_ENABLED=false
# bucket 名。键名是 OSS_BUCKET，不是 OSS_BUCKET_NAME（后者会被静默忽略）。
OSS_BUCKET=venus-dev
# 公网 endpoint，本地开发用它。
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# 内网 endpoint，仅同地域 VPC 内生效，本地连不通，留着给线上参照，默认别启用：
# OSS 走 mock 时，这一项会被当成 mock 图片 URL 的前缀（见 services/oss.py 的 signed_get_url）。
# OSS_INTERNAL_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
# OSS 专用 AK，留空则回落到上面的 ALI_ACCESS_KEY_ID/SECRET。
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# 给远端 LLM 签公网 GET URL 用的 bucket 域名，留空则按 OSS_ENDPOINT 推。
# OSS_PUBLIC_BASE_URL=
# 留空 = 后端代传（只要 AK 即可）；填了才走前端 STS 直传
OSS_STS_ROLE_ARN=
# STS 临时凭据有效期（秒）。代码默认 900，本地取 300 够用。
OSS_STS_TTL=300
# STS 接入点，留空按 ALI_REGION 自动拼 sts.<region>.aliyuncs.com。
# OSS_STS_ENDPOINT=
# 下载签名 URL 有效期（秒），需覆盖单次分析耗时。
# OSS_DOWNLOAD_URL_TTL=600

# Content Moderation
# 内容安全服务的地域，与 ALI_REGION 独立。
ALI_GREEN_REGION=cn-shanghai
# 内容安全总开关。阿里云 Green 的 imageScan/textScan 尚未实现（代码里是
# NotImplementedError），置 true 会让上传照片直接报错。保持 false 走 mock 机审：
# object_key 含 REJECT 判违规，文本只匹配几个固定敏感词。
MODERATION_ENABLED=false

# SMS
# ALI_ACCESS_KEY_ID/SECRET + ALI_SMS_SIGN + ALI_SMS_TEMPLATE_LOGIN 四项全齐才发真实短信；
# 任一为空即测试模式：只有 SMS_TEST_PHONE_PREFIX(133) 开头的号能登录，验证码恒为 SMS_TEST_CODE。
# 与 APP_ENV 无关——dev 填齐了照样会真发短信、真扣额度。
# ALI_SMS_SIGN 是已审签名，ALI_SMS_TEMPLATE_LOGIN 是模板 code（如 SMS_456789012），模板需含 ${code}
ALI_SMS_SIGN=
ALI_SMS_TEMPLATE_LOGIN=
# 测试模式下的固定验证码。
SMS_TEST_CODE=100000
# 测试模式下允许登录的号段前缀。
SMS_TEST_PHONE_PREFIX=133

# === 微信小程序 ===
# 两者任一为空 = mock：openid 由 wx.login 的 code 派生，「手机号授权」返回 133 开头的假号，
# 不用申请任何微信资质就能在开发者工具里跑通登录。填上正式 appid/secret 即走真实接口。
# 注意小程序端的 appid 另在 apps/miniapp/project.config.json（开发者工具读它，不走 env）。
WX_APPID=
WX_SECRET=
# wx/login 返回 needPhone 后，用户点「手机号授权」的容忍间隔（秒）。
WX_BIND_TTL_SECONDS=300

# === LLM ===
# mock | async(SSE 流式) | sync(一次性返回) | queue(提交+轮询)
# mock = 读 apps/api/mock/sample_report.json 伪流式，不需要任何模型服务
LLM_PROVIDER=mock
# async 用
LLM_QWEN_BASE_URL=http://llm-service:8080
# sync / queue 共用
LLM_SYNC_BASE_URL=
# 下游 LLM 超时（秒）。代码默认 600；本地 mock 秒回，取 60 好让配错时快点失败。
# 接真实模型时务必调回 600 量级，别沿用这里的 60。
LLM_TIMEOUT_SECONDS=60
# queue 模式轮询下游任务状态的间隔（秒）。
# LLM_POLL_INTERVAL_SECONDS=2.0
# 调下游 LLM 的 httpx 连接池上限（每 worker）。
# LLM_HTTP_MAX_CONNECTIONS=200
# LLM_HTTP_MAX_KEEPALIVE=50
# 后台分析进程内并发上限，超过则页面内排队。全局在途 = UVICORN_WORKERS × 本值。
# ANALYZE_MAX_CONCURRENCY=5
# 重启重放窗口（秒）。启动时把 DB 里卡在 queued/streaming 的在途任务重跑，超窗口的标记 failed。
# ANALYZE_RECOVER_MAX_AGE_SECONDS=1800
# 仅 LLM_PROVIDER=mock 生效：伪流式的节奏系数。1.0≈单份 24s（贴近真实时序）；
# 设 0 则瞬时返回，调前端样式/压测时把它调成 0 最省时间。
MOCK_FRAME_DELAY=1.0

# === Rate limit ===
# 同一 IP 每分钟可发几条验证码。
RL_SMS_IP_PER_MIN=5
# 同一手机号每分钟可发几条。
RL_SMS_PHONE_PER_MIN=1
# 同一手机号每天可发几条。
RL_SMS_PHONE_PER_DAY=10
# 同一用户每小时可发起几次分析。
RL_ANALYZE_PER_HOUR=3
# 同一用户每天可发起几次分析。
RL_ANALYZE_PER_DAY=5

# === Photo ===
# 原图保留天数，到期由清理任务删除。
PHOTO_TTL_DAYS=10
# 单张上传上限（字节），5 MiB。
PHOTO_MAX_BYTES=5242880

# === 等待页文案（前端从 /api/config 拉，改完重启 API 即生效，不用重新构建前端）===
# 预估耗时（秒），用于进度条节奏。
# ANALYZE_ETA_SECONDS=150
# ANALYZE_TITLE_PREPARING=AI 分析准备中…
# ANALYZE_TITLE_ANALYZING=AI 正在为您分析…
# ANALYZE_SUBTITLE=分型 · 分相 · 分区 · 分层
# 轮播提示语，用 | 分隔多条。
# ANALYZE_WAIT_HINTS=正在读取面部轮廓与光影结构…|比对分型 / 分相 / 分区 / 分层四维模型…|结合个人特征生成美学建议…|即将完成，正在整理报告…
# ANALYZE_WAIT_NOTE=请勿关闭页面
