# 生产环境「运行时」配置样例 —— 完整清单，避免漏配。
# 部署时复制到服务器 /etc/venus-4s/.env 填真实值，权限 chmod 600，切勿提交真实值。
#   sudo cp /srv/venus-4s/config/prod.secrets.example /etc/venus-4s/.env
#   sudo chmod 600 /etc/venus-4s/.env
#
# 优先级说明：pydantic 里「运行时 env_file(/etc/venus-4s/.env)」优先级高于镜像内
# 烤进的基线 .env(config/prod.baseline.env)。所以：
#   - 【密钥项】必须在这里填，镜像里没有，不填起不来。
#   - 【非密钥项】镜像基线已有兜底值；这里再列一遍是为了「一处看全、避免漏配」，
#     想改就在这里改（覆盖基线），不改可整行删掉走基线值。
#
# 注意：本文件里任何一行只要没被注释掉，就会**覆盖**镜像基线的同名项。
# 非密钥项的取值必须与 config/prod.baseline.env 保持一致，否则会把调好的基线覆盖回旧值。
#
# 本文件的键清单与 apps/api/app/core/config.py 的 Settings 一一对应，勿增勿漏。
# 注释掉的行 = 保持代码/基线默认值即可，值写在注释里，要改去掉行首 # 号。

# ========== App（非密钥，基线已有）==========
# 生产必须 prod：开启启动自检，缺凭据 / 留占位串一律拒绝启动。
APP_ENV=prod
# 线上必须 false，否则报错页泄露栈与配置。
APP_DEBUG=false
# 站点域名，须与证书域名一致。
APP_BASE_URL=https://rernaco.com
WEB_BASE_URL=https://rernaco.com
# 跨域白名单（逗号分隔完整 origin）。同域部署保持留空，不要无谓放开。
CORS_ORIGINS=
# mock 放行名单（所有环境生效）。未列进来的 mock 子系统会让 API 拒绝启动。
# 可选值 sms / wechat / llm / moderation / oss。基线默认放行 wechat（小程序内测中）
# 与 moderation（阿里云 Green 未接入）。每去掉一项 = 把该子系统切成真实服务。
# 上线前先预检，配置不对就不动线上：
#   docker compose -f docker-compose.ecs.yml run --rm api python -m app.core.preflight
ALLOW_MOCK=wechat,moderation

# ========== Database：RDS MySQL 内网地址（密钥，必填）==========
# 格式 mysql+aiomysql://<user>:<pass>@<rds内网域名>:3306/<db>（VPC 内网，不走公网）
DATABASE_URL=mysql+aiomysql://venus:REPLACE_DB_PASS@rm-xxxxxx.mysql.rds.aliyuncs.com:3306/venus
# DB 连接池（每 worker 一份）。总连接 ≈ (POOL_SIZE + MAX_OVERFLOW) × UVICORN_WORKERS，须 ≤ RDS max_connections。
# 与基线一致：4 worker × (10+20) = 120。
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# 池满后等待连接的超时（秒）。
# DB_POOL_TIMEOUT=30
# uvicorn worker 进程数。全局分析并发 = UVICORN_WORKERS × ANALYZE_MAX_CONCURRENCY。
# UVICORN_WORKERS=4

# ========== Redis：KVStore(云数据库Redis) 内网地址（密钥，必填）==========
# 有密码：redis://:<pass>@<内网域名>:6379/0
REDIS_URL=redis://:REPLACE_REDIS_PASS@r-xxxxxx.redis.rds.aliyuncs.com:6379/0
# Redis 连接池上限（每 worker）。KVStore 规格小则调小。
# REDIS_MAX_CONNECTIONS=200

# ========== JWT ==========
# JWT_SECRET 为密钥，必填：openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
# access token 有效期（秒），默认 1 小时。
JWT_ACCESS_TTL_SECONDS=3600
# refresh token 有效期（秒），默认 7 天。改小会让用户更频繁重新登录。
JWT_REFRESH_TTL_SECONDS=604800

# ========== 管理员令牌（密钥，必填才可用 /api/admin/* 导数接口）==========
# 保护返回解密手机号等 PII 的接口；留空则接口一律 403（fail-closed）。
# 生成：openssl rand -hex 32。调用时请求头带 X-Admin-Token: <此值>
ADMIN_TOKEN=REPLACE_WITH_openssl_rand_hex_32

# ========== 手机号加密（AES-GCM，密钥，必填）==========
# PHONE_DEK_BASE64: openssl rand -base64 32，数据密钥，换了历史密文即无法解密
# PHONE_HMAC_KEY:   openssl rand -hex 32，盲索引密钥，换了历史数据即查不出
PHONE_DEK_BASE64=REPLACE_base64_32_bytes
PHONE_HMAC_KEY=REPLACE_hmac_256bit

# ========== 阿里云凭证（密钥，必填；建议 RAM 子账号，最小权限）==========
ALI_ACCESS_KEY_ID=REPLACE_ACCESS_KEY_ID
ALI_ACCESS_KEY_SECRET=REPLACE_ACCESS_KEY_SECRET

# ========== 阿里云区域 / OSS（非密钥，基线已有；数值须与 prod.baseline.env 一致）==========
# 短信等通用服务的地域。
ALI_REGION=cn-beijing
# 总开关，false = 原图落容器本地磁盘（容器重建即丢，多实例互相读不到），线上必须 true
OSS_ENABLED=true
# 键名是 OSS_BUCKET，不是 OSS_BUCKET_NAME（后者会被静默忽略）
OSS_BUCKET=rerna
# 后端与 bucket 同在北京 VPC，走内网 endpoint 省流量
OSS_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
# 另一路内网接入点，本项目已把内网地址写进 OSS_ENDPOINT，留空即可。
# OSS_INTERNAL_ENDPOINT=
# OSS 专用 AK（密钥）。留空则回落到上面的 ALI_ACCESS_KEY_ID/SECRET，本项目走回落。
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# 给远端 LLM 签公网 GET URL 用的 bucket 虚拟主机域名。
OSS_PUBLIC_BASE_URL=https://rerna.oss-cn-beijing.aliyuncs.com
# 留空 = 后端代传（不用 STS）；走前端直传才填，把 <账号ID> 换成主账号 ID（纯数字）
# OSS_STS_ROLE_ARN=acs:ram::<账号ID>:role/venus-uploader
OSS_STS_ROLE_ARN=
# STS 临时凭据有效期（秒），仅启用直传后生效。
OSS_STS_TTL=900
# STS 接入点，留空按 ALI_REGION 自动拼 sts.<region>.aliyuncs.com。
OSS_STS_ENDPOINT=
# 配了 OSS 时给 LLM 拉图的签名 URL 有效期（秒），默认 600（10 分钟），够 LLM 拉完即可
OSS_DOWNLOAD_URL_TTL=600

# ========== 内容审核（非密钥，基线已有）==========
# 内容安全服务的地域，与 ALI_REGION 独立（Green 只在部分地域提供）。
ALI_GREEN_REGION=cn-shanghai
# 阿里云 Green 的 imageScan/textScan 尚未实现（代码里是 NotImplementedError），
# 置 true 会让照片审核直接抛错、任务卡住。接入前保持 false + ALLOW_MOCK 含 moderation。
MODERATION_ENABLED=false

# ========== 短信签名/模板（非密钥，已审核通过的公开标识，基线已有）==========
# ALI_SMS_SIGN 是已审签名；ALI_SMS_TEMPLATE_LOGIN 是模板 code（如 SMS_456789012），模板需含 ${code}
# 二者 + 阿里云 AK 全部填齐 = 走真实短信；任一为空 = 测试模式（见下）
ALI_SMS_SIGN=
ALI_SMS_TEMPLATE_LOGIN=

# ========== 短信测试模式（仅未配短信模板时生效；代码内已有默认值，一般无需改）==========
# 仅 SMS_TEST_PHONE_PREFIX 开头的手机号能收到固定验证码 SMS_TEST_CODE，其他号码报 403。
SMS_TEST_CODE=100000
SMS_TEST_PHONE_PREFIX=133

# ========== 微信小程序（WX_SECRET 是密钥，只能放这里，不能进镜像基线）==========
# 内测期两项都留空 = mock（假 openid + 133 假手机号），由 ALLOW_MOCK=wechat 放行。
# 正式上线：填真实值 + 从 ALLOW_MOCK 去掉 wechat，然后
#   docker compose -f docker-compose.ecs.yml up -d api cron
# 即切真实，不用重新打镜像。
# WX_APPID 在微信公众平台「开发管理-开发设置」；WX_SECRET 只在生成时可见一次。
# 另需在微信后台配置服务器域名白名单：request 与 socket 都要加 https://rernaco.com
# （报告页实时进度走 /api/analyze/{id}/ws，漏配 socket 会只白屏不报错）。
WX_APPID=
WX_SECRET=
# wx/login 返回 needPhone 后，用户点「手机号授权」的容忍间隔（秒）
WX_BIND_TTL_SECONDS=300

# ========== LLM（非密钥，基线已有）==========
# mock | async(SSE 流式) | sync(一次性返回) | queue(提交+轮询)
# 保持 mock 上线 = 所有人拿到同一份样例报告，须在 ALLOW_MOCK 里显式放行 llm 才启动得来
LLM_PROVIDER=queue
# async 模式用的流式端点，其他模式留空。
LLM_QWEN_BASE_URL=
# queue/sync 必填真实地址，留占位串会被启动自检拦下
LLM_SYNC_BASE_URL=https://your-llm-endpoint
# 真实出报告可能数分钟，与基线保持一致给到 600，不要沿用本地的 60
LLM_TIMEOUT_SECONDS=600
# queue 模式轮询下游任务状态的间隔（秒）。调小更跟手，但放大下游 QPS。
# LLM_POLL_INTERVAL_SECONDS=2.0
# 调下游 LLM 的 httpx 连接池上限（每 worker），与基线一致给 10。
# LLM_HTTP_MAX_CONNECTIONS=10
# LLM_HTTP_MAX_KEEPALIVE=10
# 后台分析进程内并发上限（每 worker）。全局在途 = UVICORN_WORKERS × 本值，须卡在下游 LLM 并发上限以下。
# ANALYZE_MAX_CONCURRENCY=7
# 重启重放窗口（秒）：窗口内卡在 queued/streaming 的任务重跑，超窗口的标记 failed。
# ANALYZE_RECOVER_MAX_AGE_SECONDS=1800
# 仅 LLM_PROVIDER=mock 生效的伪流式节奏系数，线上走 queue，本项无影响。
# MOCK_FRAME_DELAY=1.0

# ========== 限流（非密钥，基线已有；此处数值须与基线一致，否则会把基线覆盖回小值）==========
# 同一 IP 每分钟可发几条验证码。
RL_SMS_IP_PER_MIN=5
# 同一手机号每分钟 / 每天可发几条。
RL_SMS_PHONE_PER_MIN=1
RL_SMS_PHONE_PER_DAY=10
# 同一用户每小时可发起几次分析（活动现场按 200 放开）。
RL_ANALYZE_PER_HOUR=200
# 同一用户每天可发起几次分析。
RL_ANALYZE_PER_DAY=5

# ========== 照片（非密钥，基线已有）==========
# 原图保留天数，到期由清理任务删除。
PHOTO_TTL_DAYS=10
# 单张上传上限（字节），5 MiB。
PHOTO_MAX_BYTES=5242880

# ========== 分析页文案 / 预计等待时长（非密钥，代码内已有默认值；改完重启 api 即生效）==========
# 真实出报告约 2–3 分钟，按实际调这里，前端 /api/config 实时读取，无需重打 web 镜像
ANALYZE_ETA_SECONDS=150
# 排队/准备阶段标题。
ANALYZE_TITLE_PREPARING=AI 分析准备中…
# 出流阶段标题。
ANALYZE_TITLE_ANALYZING=AI 正在为您分析…
# 标题下方副标。
ANALYZE_SUBTITLE=分型 · 分相 · 分区 · 分层
# 等待期滚动提示，多条用「|」分隔
ANALYZE_WAIT_HINTS=正在读取面部轮廓与光影结构…|比对分型 / 分相 / 分区 / 分层四维模型…|结合个人特征生成美学建议…|即将完成，正在整理报告…
# 底部固定提示。
ANALYZE_WAIT_NOTE=请勿关闭页面
