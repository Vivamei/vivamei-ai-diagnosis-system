# 烤进 api 镜像的「非敏感」基线配置（构建时 COPY 到镜像 /app/.env）。
# 只放非密钥项；密钥绝不写这里。
#
# 密钥（DB/Redis 口令、JWT_SECRET、手机号加解密密钥、阿里云 AK Secret）由服务器
# /etc/venus-4s/.env 在运行时注入 —— pydantic 里「环境变量」优先级高于 .env 文件，
# 所以运行时注入的同名项会覆盖这里的值，未注入的项则用这里的基线值兜底。
#
# 本文件列出 Settings 的全部字段：注释掉的行 = 用代码默认值，或该项是密钥/运行时注入项。
# infra/build.sh 会扫描本文件，凡是密钥键带上了非空值就直接中止构建。
#
# 改这里任何一项都需要「重新打镜像」才生效；密钥项改服务器 /etc/venus-4s/.env 后重启容器即可。

# === App ===
# 生产必须是 prod：开启各项启动自检（缺凭据、占位串一律拒绝启动）。
APP_ENV=prod
# 线上必须 false，否则报错页会泄露栈与配置。
APP_DEBUG=false
# 站点域名。前端、小程序、短信落地页拼绝对地址都用它，须与证书上的域名一致。
# nginx（infra/nginx/edge.conf）用 server_name _ + $host 跳转，换域名不用改 nginx。
APP_BASE_URL=https://rernaco.com
WEB_BASE_URL=https://rernaco.com
# 跨域来源白名单（逗号分隔的完整 origin，含协议与端口）。留空 = 不挂 CORS 中间件。
# 默认部署里前端与 API 同域（Nginx 反代 /api），本就无跨域，保持留空，不要无谓放开。
# 仅当 H5 挂在独立域名（如走 CDN）时才填，例如：
# CORS_ORIGINS=https://h5.rernaco.com
# 小程序不受同源策略约束，与此项无关（它看的是微信后台的服务器域名白名单）。
CORS_ORIGINS=

# === mock 放行名单（所有环境生效）===
# 各子系统缺配置会自动降级成 mock。未列进本名单的 mock 会让 API 拒绝启动，
# 避免「漏配 → 静默降级 → 线上发不出真短信」这类只有用户能发现的故障。
# 可选值：sms / wechat / llm / moderation / oss（见 apps/api/app/core/preflight.py）
#
#   wechat     —— 小程序内测中，尚无正式 appid/secret，故显式放行
#   moderation —— 阿里云 Green 的 imageScan/textScan 尚未实现（见下方 MODERATION_ENABLED）
#
# 每去掉一项，就是把对应子系统切成真实服务。上线前用下面这条预检，配置不对就不动线上：
#   docker compose -f docker-compose.ecs.yml run --rm api python -m app.core.preflight
ALLOW_MOCK=wechat,moderation

# === 数据库 / 缓存（连接串含口令，属密钥，运行时由 /etc/venus-4s/.env 注入）===
# DATABASE_URL=mysql+aiomysql://<user>:<pass>@<rds-host>:3306/venus
# REDIS_URL=redis://:<pass>@<kvstore-host>:6379/0
# Redis 连接池上限（每 worker）。默认 200，够用；KVStore 规格小则调小。
# REDIS_MAX_CONNECTIONS=200

# === JWT TTL（非密钥；JWT_SECRET 走运行时注入）===
# JWT_SECRET=<openssl rand -hex 32>   ← 密钥，写服务器 /etc/venus-4s/.env
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# === 管理员令牌（密钥，运行时注入）===
# 保护 /api/admin/*（返回解密手机号等 PII）。留空 = 接口一律拒绝（fail-closed）。
# ADMIN_TOKEN=

# === 手机号加密密钥（密钥，运行时注入；换了 HMAC_KEY 历史数据即查不出）===
# PHONE_DEK_BASE64=<base64 32 bytes>
# PHONE_HMAC_KEY=<random 256bit>

# === 阿里云区域 / OSS（均为非密钥，AK 密钥走运行时注入）===
ALI_REGION=cn-beijing
# ALI_ACCESS_KEY_ID / ALI_ACCESS_KEY_SECRET 是密钥，写服务器 /etc/venus-4s/.env：
# ALI_ACCESS_KEY_ID=
# ALI_ACCESS_KEY_SECRET=
# 总开关，置 true 走 OSS；密钥 ALI_ACCESS_KEY_ID/SECRET 由运行时 .env 注入
OSS_ENABLED=true
# 键名是 OSS_BUCKET，不是 OSS_BUCKET_NAME（后者会被静默忽略）
OSS_BUCKET=rerna
# 后端与 bucket 同在北京 VPC，上传走内网 endpoint 省流量
OSS_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
# 另一路内网接入点，留空即可（本项目已把内网地址直接写进 OSS_ENDPOINT）
# OSS_INTERNAL_ENDPOINT=
# OSS 专用 AK（密钥）。留空则回落到 ALI_ACCESS_KEY_ID/SECRET，本项目走回落，不必单配。
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# 给远端 LLM 签公网 GET URL 用（bucket 虚拟主机域名）
OSS_PUBLIC_BASE_URL=https://rerna.oss-cn-beijing.aliyuncs.com
# 留空 = 后端代传模式（不用 STS）；走前端直传再填真实 role ARN
OSS_STS_ROLE_ARN=
# STS 临时凭据有效期（秒）。仅在启用直传后生效。
OSS_STS_TTL=900
# STS 接入点，留空按 ALI_REGION 自动拼 sts.<region>.aliyuncs.com
OSS_STS_ENDPOINT=
# 签名 URL 有效期（秒），需覆盖单次分析耗时（真实约数分钟）
OSS_DOWNLOAD_URL_TTL=600
# 内容安全服务的地域，与 ALI_REGION 独立（Green 只在部分地域提供）。
ALI_GREEN_REGION=cn-shanghai
# 内容安全总开关。阿里云 Green 的 imageScan/textScan 尚未实现
# （apps/api/app/services/moderation.py 里是 NotImplementedError），置 true 会让照片
# 审核直接抛错、任务卡住。接入前必须保持 false，并在 ALLOW_MOCK 里放行 moderation。
MODERATION_ENABLED=false

# === 短信签名/模板（已审核通过的公开标识，非密钥）===
# 签名与模板 code（如 SMS_456789012），模板正文需含 ${code}。
# 这两项 + 阿里云 AK 四项全齐才发真实短信，任一为空即测试模式。
ALI_SMS_SIGN=
ALI_SMS_TEMPLATE_LOGIN=
# 测试模式下的固定验证码与放行号段。线上四项配齐后这两项不生效。
SMS_TEST_CODE=100000
SMS_TEST_PHONE_PREFIX=133

# === 微信小程序 ===
# WX_APPID / WX_SECRET 任一为空即走 mock：openid 由 code 派生、授权手机号返回 133 假号。
# 内测期不填，由上面的 ALLOW_MOCK=wechat 显式放行。
# 拿到正式凭据后：WX_APPID 是公开标识，可填在下面并重打镜像；WX_SECRET 是密钥，只能写进
# 服务器 /etc/venus-4s/.env（本文件会被烤进镜像）。之后从 ALLOW_MOCK 去掉 wechat 重启容器。
WX_APPID=
# WX_SECRET=  ← 密钥，写服务器 /etc/venus-4s/.env
# 绑定令牌有效期：wx/login 返回 needPhone 后，用户点「手机号授权」的容忍间隔（秒）。
WX_BIND_TTL_SECONDS=300

# === LLM ===
# mock | async(SSE 流式) | sync(一次性返回) | queue(提交+轮询)
LLM_PROVIDER=queue
LLM_QWEN_BASE_URL=
# queue/sync 模式必填，且不能留占位串，否则 APP_ENV=prod 下启动自检直接拒绝启动
LLM_SYNC_BASE_URL=https://your-llm-endpoint
# 下游 LLM 超时（秒）。真实出报告可能数分钟，给到 600（10 分钟）留足余量
LLM_TIMEOUT_SECONDS=600
# queue 模式轮询下游任务状态的间隔（秒）。调小更跟手，但会放大下游 QPS。
LLM_POLL_INTERVAL_SECONDS=2.0
# 后台分析进程内并发上限，超过则页面内排队。全局在途 = UVICORN_WORKERS × 本值。
# 下游 LLM 最大并发 30：4 worker × 7 = 28，卡在 30 以下，避免打爆下游。改并发先动这里。
ANALYZE_MAX_CONCURRENCY=7
# 重启重放窗口（秒）。启动时把 DB 里卡在 queued/streaming 的在途任务重跑：本窗口内的重放，
# 超窗口的（用户早已放弃）标记 failed。默认 1800，与 SSE buffer TTL / LLM 超时对齐
ANALYZE_RECOVER_MAX_AGE_SECONDS=1800
# 调下游 LLM 的 httpx 连接池上限（每 worker）。每个在途分析全程占 1 条连接达 LLM_TIMEOUT_SECONDS，
# 突发高并发按每 worker 峰值在途数调大。下游 LLM 最大并发 30，全局在途已被 ANALYZE_MAX_CONCURRENCY
# ×UVICORN_WORKERS 卡在 28，故每 worker 连接池给 10（略高于每 worker 并发 7）即够。
LLM_HTTP_MAX_CONNECTIONS=10
LLM_HTTP_MAX_KEEPALIVE=10
# 仅 LLM_PROVIDER=mock 生效的伪流式节奏系数，线上走 queue，本项无影响。
# MOCK_FRAME_DELAY=1.0
# uvicorn worker 进程数。突发高并发时调大（如 4）：全局并发 = UVICORN_WORKERS × ANALYZE_MAX_CONCURRENCY
UVICORN_WORKERS=4
# DB 连接池（每 worker 一份）。总连接 ≈ (DB_POOL_SIZE + DB_MAX_OVERFLOW) × UVICORN_WORKERS，须 ≤ RDS max_connections
# 200 人/2 分钟突发：4 worker × (10+20) = 120，须确认 RDS max_connections ≥ ~150（留运维余量）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 池满后等待连接的超时（秒），超时抛 TimeoutError。
DB_POOL_TIMEOUT=30

# === 限流 ===
# 同一 IP 每分钟可发几条验证码。
RL_SMS_IP_PER_MIN=5
# 同一手机号每分钟 / 每天可发几条。
RL_SMS_PHONE_PER_MIN=1
RL_SMS_PHONE_PER_DAY=10
# 同一用户每小时可发起几次分析（活动现场按 200 放开）。
RL_ANALYZE_PER_HOUR=200
# 同一用户每天可发起几次分析。
RL_ANALYZE_PER_DAY=5

# === 照片 ===
# 原图保留天数，到期由清理任务删除。
PHOTO_TTL_DAYS=10
# 单张上传上限（字节），5 MiB。
PHOTO_MAX_BYTES=5242880

# === 等待页文案（前端从 /api/config 拉，改完重启容器即生效，不用重新构建前端）===
# 预估耗时（秒），用于进度条节奏。真实出报告更慢时调大，否则进度条会先满后干等。
# ANALYZE_ETA_SECONDS=150
# ANALYZE_TITLE_PREPARING=AI 分析准备中…
# ANALYZE_TITLE_ANALYZING=AI 正在为您分析…
# ANALYZE_SUBTITLE=分型 · 分相 · 分区 · 分层
# 轮播提示语，用 | 分隔多条。
# ANALYZE_WAIT_HINTS=正在读取面部轮廓与光影结构…|比对分型 / 分相 / 分区 / 分层四维模型…|结合个人特征生成美学建议…|即将完成，正在整理报告…
# ANALYZE_WAIT_NOTE=请勿关闭页面
